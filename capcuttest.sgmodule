#!name=CapCut Pro Unlock
#!desc=Unlocks CapCut Pro subscription status in API responses
#!author=System
#!homepage=

[MITM]
hostname = %APPEND% api.capcut.com, api2.capcut.com, *.capcut.com, *.tiktokv.com, *.byteoversea.com

[Script]
CapCut_Unlock = type=http-response,pattern=^https?:\/\/.*(capcut|tiktokv|byteoversea|ibytedtos|byteintlapi)\.com\/.*,requires-body=1,script-path=https://raw.githubusercontent.com/your-repo/capcut-unlock.js,timeout=10
